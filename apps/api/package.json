{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "dev": "tsx watch --include '../../packages/orpc/dist/**/*.js' main.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx migrate.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@orpc/server": "1.15.5",
    "@repo/orpc": "workspace:*",
    "hono": "4.13.13"
  }
}
