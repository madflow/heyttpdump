{
  "name": "heyttpdump-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.11.1"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite --port 3002",
    "build": "vite build && node scripts/build-node.mjs",
    "preview": "node dist/node/main.js",
    "check": "node scripts/generate-routes.mjs && tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/node/main.js"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@repo/orpc": "workspace:*",
